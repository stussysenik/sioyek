<div class="panel">
  <h1>Users</h1>
  <p class="muted">Lightweight admin view for support and sync inspection.</p>
</div>

<div class="panel">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Role</th>
        <th>Devices</th>
        <th>Library entries</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><span class="label"><%= user.role %></span></td>
          <td><%= user.devices.count %></td>
          <td><%= user.library_entries.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
